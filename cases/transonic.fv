# the legacy case mesh: NACA 0012, sized for M = 0.8 at 1.25 deg
# The operating point itself is not here yet -- these are mesh keys, and the
# `flow` command takes mach/alpha directly.  A deck carrying both arrives with
# `solve`, which is the first command that needs them together.
airfoil=0012
n_surface=192
n_radial=64
far_field_radius=20.0
first_cell_height=2e-3
